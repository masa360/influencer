# ============================================================
# 基本設定
# ============================================================
# GEMINI_API_KEY: Gemini API (返信生成に必須)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: このアプリの公開URL（Webhook URLの表示に使用）
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Geminiのモデルを変更したい場合（省略可。テキスト: gemini-3.8-flash / 画像: gemini-3.1-flash-lite-image）
# GEMINI_MODEL=""
# GEMINI_IMAGE_MODEL=""

# ============================================================
# 自動返信（API連携）
# ============================================================
# 【必須・本番】管理画面・管理API(/api/admin/*)・生成API(/api/generate-*, /api/chat-dm)を保護するトークン。
# Geminiの利用料が勝手に使われるのを防ぎます。長いランダム文字列にしてください。
# 例: openssl rand -hex 32
ADMIN_TOKEN=""

# 設定データ(受信ログ・設定・トークン)の保存先。Cloud Run等では永続ボリュームを指定してください。
# DATA_DIR="data"

# /api/v1/reply 用のAPIキー。未設定なら初回起動時に自動生成され、管理画面で確認できます。
# INBOUND_API_KEY=""

# ---- X (旧Twitter) ----
# 有料APIプランが前提のため、現在は対象外です。

# ---- Instagram / Facebook (Meta) ----
# Webhook: {APP_URL}/webhooks/meta  （Verify Token は下記と同じ値を登録）
META_APP_SECRET=""
META_VERIFY_TOKEN=""     # 任意の文字列
META_PAGE_ACCESS_TOKEN="" # ページアクセストークン（長期）
# META_IG_ACCESS_TOKEN=""  # Instagramで別トークンを使う場合のみ
# META_GRAPH_VERSION="v21.0"

# ---- LINE公式アカウント ----
# Webhook: {APP_URL}/webhooks/line
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# ---- YouTube（コメントを定期取得して返信。要 youtube.force-ssl スコープのOAuth） ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
# チャンネルIDは管理画面で設定します

# ---- LP/HP フォームからのメール返信（任意。Resend） ----
# RESEND_API_KEY=""
# MAIL_FROM="info@example.com"
# MAIL_SUBJECT="お問い合わせありがとうございます"
